table fact_estadia
	lineageTag: 7f992c64-6c6c-4153-96dd-beaf833a4292

	measure Reservas = SUM(fact_estadia[cantidad_estadias])
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: 749d7c38-f6bc-4907-8a0b-ee40a8844bde

	measure 'Noches vendidas' = SUM(fact_estadia[noches])
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: 22ff4ba8-4371-422c-82c6-fe5052e700f7

	measure 'Ingreso (S/)' = SUM(fact_estadia[monto_pagado])
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: 57708ee6-74a7-4ffd-9bea-a4afeb1108db

	measure 'Consumos (S/)' = SUM(fact_estadia[total_consumos])
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: 92112132-aacb-48ff-a16c-10aed2be5efa

	measure Canceladas = CALCULATE([Reservas], fact_estadia[es_cancelada] = TRUE())
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: d0524aa1-e83f-4ea8-b031-1441c2639a25

	measure No-show = CALCULATE([Reservas], fact_estadia[es_no_show] = TRUE())
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: d452fff5-a445-42f4-9457-7d4ab9f3eb6a

	measure Finalizadas = CALCULATE([Reservas], fact_estadia[es_finalizada] = TRUE())
		formatString: #,0
		displayFolder: Medidas base
		lineageTag: 60b3ca0f-c01d-4dc8-9c20-ca20092697d5

	measure '% Cancelación' = DIVIDE([Canceladas], [Reservas])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 75f0b6aa-0b66-4f72-96fb-f5bf28158024

	measure '% No-show' = DIVIDE([No-show], [Reservas])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: 20310368-fbb6-4322-98a1-5cd3c9d70f88

	measure '% No-llegada' = DIVIDE([Canceladas] + [No-show], [Reservas])
		formatString: 0.0%
		displayFolder: KPIs
		lineageTag: b4181e8a-c37f-44fd-9c93-68c57838bc1c

	measure 'Ingreso por estadía (S/)' = DIVIDE([Ingreso (S/)], [Finalizadas])
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 5394f0f8-177e-4a4e-b295-d15af795fa16

	measure 'Reservas año anterior' = CALCULATE([Reservas], SAMEPERIODLASTYEAR(dim_tiempo[fecha]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: c53c3e21-696f-4b72-8c79-22cf44bbf976

	measure 'Var. interanual reservas' = IF(HASONEVALUE(dim_tiempo[año]), DIVIDE([Reservas] - [Reservas año anterior], [Reservas año anterior]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPIs
		lineageTag: 249faebe-1d66-410d-97dd-b7c8d1796afd

	measure 'Ingreso año anterior (S/)' = CALCULATE([Ingreso (S/)], SAMEPERIODLASTYEAR(dim_tiempo[fecha]))
		formatString: #,0
		displayFolder: KPIs
		lineageTag: 4fe2ae10-723d-41d1-95e1-98f3431f5565

	measure 'Var. interanual ingreso' = IF(HASONEVALUE(dim_tiempo[año]), DIVIDE([Ingreso (S/)] - [Ingreso año anterior (S/)], [Ingreso año anterior (S/)]))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPIs
		lineageTag: 81f0f55b-43ac-4281-b3c0-19800d9a416f

