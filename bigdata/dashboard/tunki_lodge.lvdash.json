{
  "datasets": [
    {
      "name": "kpi_2026",
      "displayName": "KPIs 2026 (mismo periodo)",
      "queryLines": [
        "SELECT reservas, ROUND(var_interanual_reservas * 100, 1) AS var_reservas_pct, ROUND(pct_cancelacion * 100, 1) AS cancelacion_pct, ROUND(pct_no_show * 100, 1) AS no_show_pct, ROUND(ingreso_por_estadia, 0) AS ingreso_por_estadia FROM workspace.tunki_gold.kpi_anual WHERE origen = 'sistema' AND `año` = 2026"
      ]
    },
    {
      "name": "mensual",
      "displayName": "KPIs mensuales",
      "queryLines": [
        "SELECT CAST(`año` AS STRING) AS `año`, mes, reservas, ROUND(pct_cancelacion * 100, 1) AS cancelacion_pct, ROUND(pct_no_llegada * 100, 1) AS no_llegada_pct FROM workspace.tunki_gold.kpi_mensual WHERE origen = 'sistema'"
      ]
    },
    {
      "name": "seg_zona",
      "displayName": "No-llegada por zona de origen",
      "queryLines": [
        "SELECT segmento, SUM(reservas) AS reservas, ROUND(100 * SUM(canceladas + no_show) / SUM(reservas), 1) AS no_llegada_pct FROM workspace.tunki_gold.no_llegada_segmento WHERE origen = 'sistema' AND dimension = 'Zona de origen' GROUP BY segmento"
      ]
    },
    {
      "name": "seg_pago",
      "displayName": "No-llegada por método de pago",
      "queryLines": [
        "SELECT segmento, SUM(reservas) AS reservas, ROUND(100 * SUM(canceladas + no_show) / SUM(reservas), 1) AS no_llegada_pct FROM workspace.tunki_gold.no_llegada_segmento WHERE origen = 'sistema' AND dimension = 'Método de pago' GROUP BY segmento"
      ]
    },
    {
      "name": "escalabilidad",
      "displayName": "EXP-BD-01 escalabilidad",
      "queryLines": [
        "SELECT CASE WHEN escenario LIKE 'Ingesta%' THEN 'Ingesta' ELSE 'Limpieza + KPIs' END AS etapa, filas, ROUND(AVG(segundos), 2) AS segundos FROM workspace.tunki_gold.experimentos WHERE experimento = 'EXP-BD-01' AND fecha_ejecucion = (SELECT MAX(fecha_ejecucion) FROM workspace.tunki_gold.experimentos) GROUP BY 1, 2"
      ]
    }
  ],
